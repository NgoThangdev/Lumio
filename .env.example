# Copy to the repository-root .env for LOCAL DEVELOPMENT ONLY.
# These are disposable example values, not real credentials or Neon settings.
# Docker Compose reads POSTGRES_*; the API and Prisma read DATABASE_URL.
POSTGRES_USER=lumio_local
POSTGRES_PASSWORD=local_dev_only_not_a_real_secret
POSTGRES_DB=lumio_local
POSTGRES_PORT=55432
DATABASE_URL=postgresql://lumio_local:local_dev_only_not_a_real_secret@127.0.0.1:55432/lumio_local?schema=public

# API Web Push: set all three to a valid matching set when testing Push.
# Keep the private key in local .env or the Render environment, never in Git.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# API notification scheduler stays off unless separately approved.
NOTIFICATION_AUTOMATION_ENABLED=false
# If enabled, use one UTC cutoff and retain it across API restarts.
# NOTIFICATION_ACTIVATION_CUTOFF=YYYY-MM-DDTHH:mm:ss.sssZ
# Optional when enabled; integer from 1 to 60, default 5.
# NOTIFICATION_URGENT_INTERVAL_MINUTES=5

# Render API: configure DATABASE_URL with the Neon connection string in Render.
# render.yaml already sets NODE_VERSION and disables notification automation.
# Render supplies NODE_ENV=production and PORT; the local launcher sets its own
# NODE_ENV and PORT. Do not copy the local DATABASE_URL into Render.

# Cloudflare Pages web: set these as build variables for the intended environment.
# The root .env is not loaded by Vite running from apps/web. For local web testing,
# use apps/web/.env or set the variables in the Vite process environment.
# VITE_RENDER_WAKE_URL is public and optional; leave it unset for normal local dev.
# VITE_RENDER_WAKE_URL=https://lumio-api-trial.onrender.com/api/ready
# Development-only smoke switch; do not enable in production builds.
# VITE_ENABLE_HOUSEHOLD_DELETION_SMOKE=true

# GitHub Actions migration: NEON_DATABASE_URL_DIRECT is a repository secret,
# not a local or Cloudflare environment variable.
