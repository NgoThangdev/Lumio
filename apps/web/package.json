{
  "name": "@lumio/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "oxlint --type-aware --react-plugin src/",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"public/*.{js,json,webmanifest}\" index.html",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"public/*.{js,json,webmanifest}\" index.html"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "i18next": "^26.5.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.1.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
